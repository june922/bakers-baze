# Server
PORT=3000

# PostgreSQL connection used by the application (env-driven, via Knex)
DATABASE_URL=postgres://user:password@localhost:5432/bakersbaze

# Discrete Postgres connection parts consumed by docker-compose.yml
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bakersbaze
